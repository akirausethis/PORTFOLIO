generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Comment {
  id        String   @id @default(uuid())
  name      String
  email     String?
  content   String
  createdAt DateTime @default(now())
}
