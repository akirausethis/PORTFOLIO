{
  "name": "portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node -e \"if(process.env.POSTGRES_URL || process.env.DATABASE_URL) { try { require('child_process').execSync('npx prisma db push --accept-data-loss', {stdio:'inherit'}) } catch(e) { console.warn('DB Push failed, skipping') } }\" && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@prisma/client": "^5.14.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.43.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^5.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
